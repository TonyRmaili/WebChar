            {
                "name": "Spellcasting",
                "type": "spellcasting",
                "headerEntries": [
                    "Amble is a 12th-level spellcaster. Their spellcasting ability is Wisdom (spell save {@dc 16}, {@hit 8} to hit with spell attacks). Amble has the following druid spells prepared:"
                ],
                "spells": {
