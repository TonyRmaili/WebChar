    "classes": [
        {
            "name": "ranger",
            "sub_class": null,
            "level": 2,
            "first_class": true,
            "class_data": {
                "1": [
                    {
                        "name": "Spellcasting",
                        "notes": "You learn to channel the magic of nature to cast Ranger spells.\n\nSpell Slots. The Ranger Features table shows how many spell slots you have to cast level 1+ spells. You regain all expended spell slots when you finish a Long Rest.\n\nPrepared Spells of Level 1+. You prepare a list of Ranger spells of level 1+ that you can cast with this feature. To start, choose two level 1 spells (Cure Wounds and Ensnaring Strike are recommended). Your number of prepared spells increases as you gain Ranger levels, as shown in the class table. Prepared spells must be of a level for which you have spell slots.\nIf another Ranger feature grants you spells that are always prepared, they don’t count against your number of prepared spells.\n\nChanging Prepared Spells. When you finish a Long Rest, you may replace one prepared spell with another Ranger spell you can cast.\n\nSpellcasting Ability. Wisdom is your spellcasting ability.\n\nSpellcasting Focus. You can use a Druidic Focus as a Spellcasting Focus for your Ranger spells.",
                        "feature_type": "core"
                    },
                    {
                        "name": "Favored Enemy",
                        "notes": "You always have the Hunter’s Mark spell prepared. You can cast it twice without expending a spell slot, regaining all expended uses when you finish a Long Rest.\nYou gain additional free uses of Hunter’s Mark at higher levels, as shown in the class table.",
                        "feature_type": "core"
                    },
                    {
                        "name": "Weapon Mastery",
                        "notes": "You can use the mastery properties of two kinds of weapons of your choice with which you have proficiency.\nWhenever you finish a Long Rest, you may change the weapon types whose mastery properties you can use (for example, switching from Longbows and Shortswords to Scimitars and Longswords).",
                        "feature_type": "core"
                    }
                ],
                "2": [
                    {
                        "name": "Deft Explorer",
                        "notes": "Your journeys have strengthened your survival skills.\n\nExpertise. Choose one of your skill proficiencies with which you lack Expertise; you gain Expertise in that skill.\n\nLanguages. You learn two additional languages of your choice from the standard language lists.",
                        "feature_type": "core"
                    },
                    {
                        "name": "Fighting Style",
                        "notes": "You gain a Fighting Style feat of your choice.\n\nAlternatively, you may choose Druidic Warrior: you learn two Druid cantrips (Guidance and Starry Wisp are recommended). These cantrips count as Ranger spells for you, and Wisdom is your spellcasting ability for them. Whenever you gain a Ranger level, you may replace one of these cantrips with another Druid cantrip.",
                        "feature_type": "core"
                    }
                ]
            },
