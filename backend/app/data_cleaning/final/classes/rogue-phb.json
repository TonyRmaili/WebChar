        "features": [
            {
                "id": "rogue-phb:expertise",
                "name": "Expertise",
                "level": 1,
                "text": "At 1st level, choose two of your skill proficiencies, or one of your skill proficiencies and your proficiency with thieves' tools. Your proficiency bonus is doubled for any ability check you make that uses either of the chosen proficiencies.\n\nAt 6th level, you can choose two more of your proficiencies (in skills or with thieves' tools) to gain this benefit.\n\n**Expertise.** At 6th level, you can choose two more of your proficiencies (in skills or with thieves' tools) to gain the benefit of Expertise.",
                "srd": {
                    "5.1": "Expertise"
                },
                "category": "traits",
                "choices": [
                    {
                        "type": "pool",
                        "id": "expertise_1",
                        "label": "Expertise",
                        "grant": "expertise",
                        "count": 2,
                        "from": "proficient_skills_tools"
                    },
                    {
                        "type": "pool",
                        "id": "expertise_2",
                        "label": "Expertise",
                        "grant": "expertise",
                        "count": 2,
                        "from": "proficient_skills_tools",
                        "at": 6
                    }
                ]
            },
            {
                "id": "rogue-phb:sneak-attack",
                "name": "Sneak Attack",
                "level": 1,
                "text": "Beginning at 1st level, you know how to strike subtly and exploit a foe's distraction. Once per turn, you can deal an extra 1d6 damage to one creature you hit with an attack if you have advantage on the attack roll. The attack must use a finesse or a ranged weapon.\n\nYou don't need advantage on the attack roll if another enemy of the target is within 5 feet of it, that enemy isn't incapacitated, and you don't have disadvantage on the attack roll.\n\nThe amount of the extra damage increases as you gain levels in this class, as shown in the Sneak Attack column of the Rogue table.",
                "srd": {
                    "5.1": "Sneak Attack"
                },
                "category": "traits",
                "action": {
                    "attack": {
                        "kind": "any",
                        "damage": [
                            {
                                "dice": "sneak_attack",
                                "type": "weapon"
                            }
                        ]
                    }
                }
            },
            {
                "id": "rogue-phb:thieves-cant",
                "name": "Thieves' Cant",
                "level": 1,
                "text": "During your rogue training you learned thieves' cant, a secret mix of dialect, jargon, and code that allows you to hide messages in seemingly normal conversation. Only another creature that knows thieves' cant understands such messages. It takes four times longer to convey such a message than it does to speak the same idea plainly.\n\nIn addition, you understand a set of secret signs and symbols used to convey short, simple messages, such as whether an area is dangerous or the territory of a thieves' guild, whether loot is nearby, or whether the people in an area are easy marks or will provide a safe house for thieves on the run.",
                "srd": {
                    "5.1": "Thieves' Cant"
                },
                "category": "traits",
                "grants": {
                    "languages": [
                        "thieves_cant"
                    ]
                }
            },
            {
                "id": "rogue-phb:cunning-action",
                "name": "Cunning Action",
                "level": 2,
                "text": "Starting at 2nd level, your quick thinking and agility allow you to move and act quickly. You can take a bonus action on each of your turns in combat. This action can be used only to take the Dash, Disengage, or Hide action.",
                "srd": {
                    "5.1": "Cunning Action"
                },
                "category": "bonus_actions"
            },
            {
                "id": "rogue-phb:steady-aim",
                "name": "Steady Aim",
                "level": 3,
                "source": "TCE",
                "text": "*3rd-level rogue optional feature*\n\nAs a bonus action, you give yourself advantage on your next attack roll on the current turn. You can use this bonus action only if you haven't moved during this turn, and after you use the bonus action, your speed is 0 until the end of the current turn.",
                "optional": true,
                "category": "bonus_actions"
            },
            {
                "id": "rogue-phb:uncanny-dodge",
                "name": "Uncanny Dodge",
                "level": 5,
                "text": "Starting at 5th level, when an attacker that you can see hits you with an attack, you can use your reaction to halve the attack's damage against you.",
                "srd": {
                    "5.1": "Uncanny Dodge"
                },
                "category": "reactions"
            },
            {
                "id": "rogue-phb:evasion",
                "name": "Evasion",
                "level": 7,
                "text": "Beginning at 7th level, you can nimbly dodge out of the way of certain area effects, such as a red dragon's fiery breath or an Ice Storm spell. When you are subjected to an effect that allows you to make a Dexterity saving throw to take only half damage, you instead take no damage if you succeed on the saving throw, and only half damage if you fail.",
                "srd": {
                    "5.1": "Evasion"
                },
                "category": "traits"
            },
            {
                "id": "rogue-phb:reliable-talent",
                "name": "Reliable Talent",
                "level": 11,
                "text": "By 11th level, you have refined your chosen skills until they approach perfection. Whenever you make an ability check that lets you add your proficiency bonus, you can treat a d20 roll of 9 or lower as a 10.",
                "srd": {
                    "5.1": "Reliable Talent"
                },
                "category": "traits"
            },
            {
                "id": "rogue-phb:blindsense",
                "name": "Blindsense",
                "level": 14,
                "text": "Starting at 14th level, if you are able to hear, you are aware of the location of any hidden or invisible creature within 10 feet of you.",
                "srd": {
                    "5.1": "Blindsense"
                },
                "category": "traits"
            },
            {
                "id": "rogue-phb:slippery-mind",
                "name": "Slippery Mind",
                "level": 15,
                "text": "By 15th level, you have acquired greater mental strength. You gain proficiency in Wisdom saving throws.",
                "srd": {
                    "5.1": "Slippery Mind"
                },
                "category": "traits",
                "grants": {
                    "saves": [
                        "wis"
                    ]
                }
            },
            {
                "id": "rogue-phb:elusive",
                "name": "Elusive",
                "level": 18,
                "text": "Beginning at 18th level, you are so evasive that attackers rarely gain the upper hand against you. No attack roll has advantage against you while you aren't incapacitated.",
                "srd": {
                    "5.1": "Elusive"
                },
                "category": "traits"
            },
            {
                "id": "rogue-phb:stroke-of-luck",
                "name": "Stroke of Luck",
                "level": 20,
                "text": "At 20th level, you have an uncanny knack for succeeding when you need to. If your attack misses a target within range, you can turn the miss into a hit. Alternatively, if you fail an ability check, you can treat the d20 roll as a 20.\n\nOnce you use this feature, you can't use it again until you finish a short or long rest.",
                "srd": {
                    "5.1": "Stroke of Luck"
                },
                "category": "traits",
                "uses": {
                    "max": 1,
                    "reset": "short"
                }
            }
        ],
        "resources": []
    }
