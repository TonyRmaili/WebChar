        "features": [
            {
                "id": "monk-xphb:martial-arts",
                "name": "Martial Arts",
                "level": 1,
                "text": "Your practice of martial arts gives you mastery of combat styles that use your Unarmed Strike and Monk weapons, which are the following:\n\n- Simple Melee Weapons\n- Martial Melee Weapons that have the Light property\n\nYou gain the following benefits while you are unarmed or wielding only Monk weapons and you aren't wearing armor or wielding a Shield.",
                "srd": {
                    "5.2": "Martial Arts"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:bonus-unarmed-strike",
                "name": "Bonus Unarmed Strike",
                "level": 1,
                "text": "You can make an Unarmed Strike as a Bonus Action.",
                "parent": "monk-xphb:martial-arts",
                "srd": {
                    "5.2": "Bonus Unarmed Strike"
                },
                "category": "bonus_actions"
            },
            {
                "id": "monk-xphb:martial-arts-die",
                "name": "Martial Arts Die",
                "level": 1,
                "text": "You can roll 1d6 in place of the normal damage of your Unarmed Strike or Monk weapons. This die changes as you gain Monk levels, as shown in the Martial Arts column of the Monk Features table.",
                "parent": "monk-xphb:martial-arts",
                "srd": {
                    "5.2": "Martial Arts Die"
                },
                "category": "actions",
                "action": {
                    "attack": {
                        "kind": "melee",
                        "damage": [
                            {
                                "dice": "martial_arts",
                                "type": "weapon"
                            }
                        ]
                    }
                }
            },
            {
                "id": "monk-xphb:dexterous-attacks",
                "name": "Dexterous Attacks",
                "level": 1,
                "text": "You can use your Dexterity modifier instead of your Strength modifier for the attack and damage rolls of your Unarmed Strikes and Monk weapons. In addition, when you use the Grapple or Shove option of your Unarmed Strike, you can use your Dexterity modifier instead of your Strength modifier to determine the save DC.",
                "parent": "monk-xphb:martial-arts",
                "srd": {
                    "5.2": "Dexterous Attacks"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:unarmored-defense",
                "name": "Unarmored Defense",
                "level": 1,
                "text": "While you aren't wearing armor or wielding a Shield, your base Armor Class equals 10 plus your Dexterity and Wisdom modifiers.",
                "srd": {
                    "5.2": "Unarmored Defense"
                },
                "category": "traits",
                "modifiers": [
                    {
                        "target": "ac",
                        "base": "10 + dex_mod + wis_mod",
                        "requires": [
                            "no_armor",
                            "no_shield"
                        ]
                    }
                ]
            },
            {
                "id": "monk-xphb:monks-focus",
                "name": "Monk's Focus",
                "level": 2,
                "text": "Your focus and martial training allow you to harness a well of extraordinary energy within yourself. This energy is represented by Focus Points. Your Monk level determines the number of points you have, as shown in the Focus Points column of the Monk Features table.\n\nYou can expend these points to enhance or fuel certain Monk features. You start knowing three such features: Flurry of Blows, Patient Defense, and Step of the Wind, each of which is detailed below.\n\nWhen you expend a Focus Point, it is unavailable until you finish a Short or Long Rest, at the end of which you regain all your expended points.\n\nSome features that use Focus Points require your target to make a saving throw. The save DC equals 8 plus your Wisdom modifier and Proficiency Bonus.",
                "srd": {
                    "5.2": "Monk's Focus"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:flurry-of-blows",
                "name": "Flurry of Blows",
                "level": 2,
                "text": "You can expend 1 Focus Point to make two Unarmed Strikes as a Bonus Action.",
                "parent": "monk-xphb:monks-focus",
                "consumes": {
                    "resource": "focus_points",
                    "amount": 1
                },
                "srd": {
                    "5.2": "Flurry of Blows"
                },
                "category": "bonus_actions"
            },
            {
                "id": "monk-xphb:patient-defense",
                "name": "Patient Defense",
                "level": 2,
                "text": "You can take the Disengage action as a Bonus Action. Alternatively, you can expend 1 Focus Point to take both the Disengage and the Dodge actions as a Bonus Action.",
                "parent": "monk-xphb:monks-focus",
                "consumes": {
                    "resource": "focus_points",
                    "amount": 1
                },
                "srd": {
                    "5.2": "Patient Defense"
                },
                "category": "bonus_actions"
            },
            {
                "id": "monk-xphb:step-of-the-wind",
                "name": "Step of the Wind",
                "level": 2,
                "text": "You can take the Dash action as a Bonus Action. Alternatively, you can expend 1 Focus Point to take both the Disengage and Dash actions as a Bonus Action, and your jump distance is doubled for the turn.",
                "parent": "monk-xphb:monks-focus",
                "consumes": {
                    "resource": "focus_points",
                    "amount": 1
                },
                "srd": {
                    "5.2": "Step of the Wind"
                },
                "category": "bonus_actions"
            },
            {
                "id": "monk-xphb:unarmored-movement",
                "name": "Unarmored Movement",
                "level": 2,
                "text": "Your speed increases by 10 feet while you aren't wearing armor or wielding a Shield. This bonus increases when you reach certain Monk levels, as shown on the Monk Features table.",
                "srd": {
                    "5.2": "Unarmored Movement"
                },
                "category": "traits",
                "modifiers": [
                    {
                        "target": "speed.walk",
                        "add": "unarmored_movement"
                    }
                ]
            },
            {
                "id": "monk-xphb:uncanny-metabolism",
                "name": "Uncanny Metabolism",
                "level": 2,
                "text": "When you roll Initiative, you can regain all expended Focus Points. When you do so, roll your Martial Arts die, and regain a number of Hit Points equal to your Monk level plus the number rolled.\n\nOnce you use this feature, you can't use it again until you finish a Long Rest.",
                "srd": {
                    "5.2": "Uncanny Metabolism"
                },
                "category": "traits",
                "uses": {
                    "max": 1,
                    "reset": "long"
                },
                "action": {
                    "heal": "class_level + martial_arts"
                }
            },
            {
                "id": "monk-xphb:deflect-attacks",
                "name": "Deflect Attacks",
                "level": 3,
                "text": "When an attack roll hits you and its damage includes Bludgeoning, Piercing, or Slashing damage, you can take a Reaction to reduce the attack's total damage against you. The reduction equals 1d10 plus your Dexterity modifier and Monk level.\n\nIf you reduce the damage to 0, you can expend 1 Focus Point to redirect some of the attack's force. If you do so, choose a creature you can see within 5 feet of yourself if the attack was a melee attack or a creature you can see within 60 feet of yourself that isn't behind Total Cover if the attack was a ranged attack. That creature must succeed on a Dexterity saving throw or take damage equal to two rolls of your Martial Arts die plus your Dexterity modifier. The damage is the same type dealt by the attack.",
                "consumes": {
                    "resource": "focus_points",
                    "amount": 1
                },
                "srd": {
                    "5.2": "Deflect Attacks"
                },
                "category": "reactions",
                "action": {
                    "save": {
                        "ability": "dex",
                        "on_success": "none",
                        "damage": [
                            {
                                "dice": "martial_arts",
                                "bonus": "dex_mod",
                                "type": "weapon"
                            },
                            {
                                "dice": "martial_arts",
                                "type": "weapon"
                            }
                        ]
                    }
                }
            },
            {
                "id": "monk-xphb:slow-fall",
                "name": "Slow Fall",
                "level": 4,
                "text": "You can take a Reaction when you fall to reduce any damage you take from the fall by an amount equal to five times your Monk level.",
                "srd": {
                    "5.2": "Slow Fall"
                },
                "category": "reactions"
            },
            {
                "id": "monk-xphb:extra-attack",
                "name": "Extra Attack",
                "level": 5,
                "text": "You can attack twice instead of once whenever you take the Attack action on your turn.",
                "srd": {
                    "5.2": "Extra Attack"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:stunning-strike",
                "name": "Stunning Strike",
                "level": 5,
                "text": "Once per turn when you hit a creature with a Monk weapon or an Unarmed Strike, you can expend 1 Focus Point to attempt a stunning strike. The target must make a Constitution saving throw. On a failed save, the target has the Stunned condition until the start of your next turn. On a successful save, the target's Speed is halved until the start of your next turn, and the next attack roll made against the target before then has Advantage.",
                "consumes": {
                    "resource": "focus_points",
                    "amount": 1
                },
                "srd": {
                    "5.2": "Stunning Strike"
                },
                "category": "traits",
                "action": {
                    "attack": {
                        "kind": "any"
                    },
                    "save": {
                        "ability": "con",
                        "on_success": "none",
                        "conditions": [
                            "stunned"
                        ]
                    }
                }
            },
            {
                "id": "monk-xphb:empowered-strikes",
                "name": "Empowered Strikes",
                "level": 6,
                "text": "Whenever you deal damage with your Unarmed Strike, it can deal your choice of Force damage or its normal damage type.",
                "srd": {
                    "5.2": "Empowered Strikes"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:evasion",
                "name": "Evasion",
                "level": 7,
                "text": "When you're subjected to an effect that allows you to make a Dexterity saving throw to take only half damage, you instead take no damage if you succeed on the saving throw and only half damage if you fail.\n\nYou don't benefit from this feature if you have the Incapacitated condition.",
                "srd": {
                    "5.2": "Evasion"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:acrobatic-movement",
                "name": "Acrobatic Movement",
                "level": 9,
                "text": "While you aren't wearing armor or wielding a Shield, you gain the ability to move along vertical surfaces and across liquids on your turn without falling during the movement.",
                "srd": {
                    "5.2": "Acrobatic Movement"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:heightened-focus",
                "name": "Heightened Focus",
                "level": 10,
                "text": "Your Flurry of Blows, Patient Defense, and Step of the Wind gain the following benefits.\n\n**Flurry of Blows.** You can expend 1 Focus Point to use Flurry of Blows and make three Unarmed Strikes with it instead of two.\n\n**Patient Defense.** When you expend a Focus Point to use Patient Defense, you gain a number of Temporary Hit Points equal to two rolls of your Martial Arts die.\n\n**Step of the Wind.** When you expend a Focus Point to use Step of the Wind, you can choose a willing creature within 5 feet of yourself that is Large or smaller. You move the creature with you until the end of your turn. The creature's movement doesn't provoke Opportunity Attacks.",
                "srd": {
                    "5.2": "Heightened Focus"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:self-restoration",
                "name": "Self-Restoration",
                "level": 10,
                "text": "Through sheer force of will, you can remove one of the following conditions from yourself at the end of each of your turns: Charmed, Frightened, or Poisoned.\n\nIn addition, forgoing food and drink doesn't give you levels of Exhaustion.",
                "srd": {
                    "5.2": "Self-Restoration"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:deflect-energy",
                "name": "Deflect Energy",
                "level": 13,
                "text": "You can now use your Deflect Attacks feature against attacks that deal any damage type, not just Bludgeoning, Piercing, or Slashing.",
                "srd": {
                    "5.2": "Deflect Energy"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:disciplined-survivor",
                "name": "Disciplined Survivor",
                "level": 14,
                "text": "Your physical and mental discipline grant you proficiency in all saving throws.\n\nAdditionally, whenever you make a saving throw and fail, you can expend 1 Focus Point to reroll it, and you must use the new roll.",
                "consumes": {
                    "resource": "focus_points",
                    "amount": 1
                },
                "srd": {
                    "5.2": "Disciplined Survivor"
                },
                "category": "traits",
                "grants": {
                    "saves": [
                        "str",
                        "dex",
                        "con",
                        "int",
                        "wis",
                        "cha"
                    ]
                }
            },
            {
                "id": "monk-xphb:perfect-focus",
                "name": "Perfect Focus",
                "level": 15,
                "text": "When you roll Initiative and don't use Uncanny Metabolism, you regain expended Focus Points until you have 4 if you have 3 or fewer.",
                "srd": {
                    "5.2": "Perfect Focus"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:superior-defense",
                "name": "Superior Defense",
                "level": 18,
                "text": "At the start of your turn, you can expend 3 Focus Points to bolster yourself against harm for 1 minute or until you have the Incapacitated condition. During that time, you have Resistance to all damage except Force damage.",
                "consumes": {
                    "resource": "focus_points",
                    "amount": 3
                },
                "srd": {
                    "5.2": "Superior Defense"
                },
                "category": "traits",
                "toggle": {
                    "grants": {
                        "defenses": {
                            "resist": [
                                "acid",
                                "bludgeoning",
                                "cold",
                                "fire",
                                "lightning",
                                "necrotic",
                                "piercing",
                                "poison",
                                "psychic",
                                "radiant",
                                "slashing",
                                "thunder",
                                "weapon"
                            ]
                        }
                    }
                }
            },
            {
                "id": "monk-xphb:body-and-mind",
                "name": "Body and Mind",
                "level": 20,
                "text": "You have developed your body and mind to new heights. Your Dexterity and Wisdom scores increase by 4, to a maximum of 25.",
                "srd": {
                    "5.2": "Body and Mind"
                },
                "category": "traits"
            },
            {
                "id": "monk-xphb:heightened-focus:flurry-of-blows",
                "name": "Flurry of Blows",
                "level": 10,
                "text": "**Flurry of Blows.** You can expend 1 Focus Point to use Flurry of Blows and make three Unarmed Strikes with it instead of two.",
                "parent": "monk-xphb:heightened-focus",
                "category": "bonus_actions",
                "consumes": {
                    "resource": "focus_points",
                    "amount": 1
                }
            },
            {
                "id": "monk-xphb:heightened-focus:patient-defense",
                "name": "Patient Defense",
                "level": 10,
                "text": "**Patient Defense.** When you expend a Focus Point to use Patient Defense, you gain a number of Temporary Hit Points equal to two rolls of your Martial Arts die.",
                "parent": "monk-xphb:heightened-focus",
                "category": "bonus_actions",
                "action": {
                    "temp_hp": "2 * martial_arts"
                },
                "consumes": {
                    "resource": "focus_points",
                    "amount": 1
                }
            },
            {
                "id": "monk-xphb:heightened-focus:step-of-the-wind",
