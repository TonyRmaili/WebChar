        "features": [
            {
                "id": "ethereal-sight",
                "name": "Ethereal Sight",
                "category": "traits",
                "text": "Ebondeath can see 60 feet into the Ethereal Plane when it is on the Material Plane, and vice versa."
            },
            {
                "id": "incorporeal-movement",
                "name": "Incorporeal Movement",
                "category": "traits",
                "text": "Ebondeath can move through other creatures and objects as if they were difficult terrain. It takes 5 (1d10) force damage if it ends its turn inside an object.",
                "action": {
                    "damage": [
                        {
                            "dice": "1d10",
                            "type": "force",
                            "condition": "if it ends its turn inside an object"
                        }
                    ]
                }
            },
            {
                "id": "legendary-resistance",
                "name": "Legendary Resistance",
                "category": "traits",
                "text": "If the dragon fails a saving throw, it can choose to succeed instead.",
                "uses": {
                    "max": 3,
                    "reset": "long"
                }
            },
            {
                "id": "withering-touch",
                "name": "Withering Touch",
                "category": "actions",
                "text": "Melee Weapon Attack: +5 to hit, reach 5 ft., one target. Hit: 17 (4d6 + 3) necrotic damage.",
                "action": {
                    "range": "reach 5 ft.",
                    "attack": {
                        "kind": "melee",
                        "bonus": 5,
                        "damage": [
                            {
                                "dice": "4d6",
                                "bonus": 3,
                                "type": "necrotic"
                            }
                        ]
                    }
                }
            },
            {
                "id": "etherealness",
                "name": "Etherealness",
                "category": "actions",
                "text": "Ebondeath enters the Ethereal Plane from the Material Plane, or vice versa. It is visible on the Material Plane while it is in the Border Ethereal, and vice versa, yet it can't affect or be affected by anything on the other plane."
            },
            {
                "id": "horrifying-visage",
                "name": "Horrifying Visage",
                "category": "actions",
                "text": "Each non-undead creature within 60 feet of Ebondeath that can see it must succeed on a DC 13 Wisdom saving throw or be frightened for 1 minute. If the save fails by 5 or more, the target also ages 1d4 × 10 years. A frightened target can repeat the saving throw at the end of each of its turns, ending the frightened condition on itself on a success. If a target's saving throw is successful or the effect ends for it, the target is immune to this Ebondeath's Horrifying Visage for the next 24 hours. The aging effect can be reversed with a Greater Restoration spell, but only within 24 hours of it occurring.",
                "action": {
                    "save": {
                        "ability": "wis",
                        "dc": 13,
                        "on_success": "none",
                        "conditions": [
                            "frightened"
                        ]
                    }
                }
            },
            {
                "id": "possession",
                "name": "Possession",
                "category": "actions",
                "text": "One humanoid that Ebondeath can see within 5 feet of it must succeed on a DC 20 Charisma saving throw or be possessed by Ebondeath; Ebondeath then disappears, and the target is incapacitated and loses control of its body. Ebondeath now controls the body but doesn't deprive the target of awareness. Ebondeath can't be targeted by any attack, spell, or other effect, except ones that turn undead, and it retains its alignment, Intelligence, Wisdom, Charisma, and immunity to being charmed and frightened. It otherwise uses the possessed target's statistics, including gaining access to the target's knowledge, class features, and proficiencies.\n\nThe possession lasts until the body drops to 0 hit points, Ebondeath ends it as a bonus action, or Ebondeath is turned or forced out by an effect like the Dispel Evil and Good spell. When the possession ends, Ebondeath reappears in an unoccupied space within 5 feet of the body. The target is immune to Ebondeath Possession for 24 hours after succeeding on the saving throw or after the possession ends.",
                "uses": {
                    "max": 1,
                    "reset": "recharge",
                    "recharge": 6
                },
                "action": {
                    "save": {
                        "ability": "cha",
                        "dc": 20,
                        "on_success": "none",
                        "conditions": [
                            "charmed",
                            "frightened",
                            "incapacitated"
                        ]
                    }
                }
            }
        ],
